<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorpoSync.MainPage"
             BackgroundColor="#F5F7F6">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="CorpoSync" FontSize="28" FontAttributes="Bold" TextColor="#2E7D6F" />
            <Label Text="Leitura da balança (Etapa 3)" FontSize="14" TextColor="#555555" />
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="Procurar balança" Clicked="OnScanClicked"
                    BackgroundColor="#2E7D6F" TextColor="White" />
            <Button Text="Parar" Clicked="OnStopClicked"
                    BackgroundColor="#B00020" TextColor="White" />
        </HorizontalStackLayout>

        <Label Grid.Row="2" x:Name="StatusLabel"
               Text="Toque em 'Procurar balança', ligue o Bluetooth e suba na balança."
               FontSize="14" TextColor="#333333" />

        <Border Grid.Row="3" Stroke="#DDDDDD" StrokeThickness="1"
                BackgroundColor="White" Padding="10">
            <ScrollView x:Name="LogScroll">
                <Label x:Name="LogLabel" FontFamily="Monospace" FontSize="12" TextColor="#222222" />
            </ScrollView>
        </Border>

    </Grid>

</ContentPage>
