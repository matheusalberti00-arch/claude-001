<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorpoSync.MainPage"
             Title="CorpoSync"
             BackgroundColor="#F5F7F6">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Perfil ativo -->
            <Border Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Perfil" FontSize="13" TextColor="#777777" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Picker x:Name="PerfilPicker" Grid.Column="0" Title="Escolha um perfil"
                                SelectedIndexChanged="OnPerfilChanged" />
                        <Button Grid.Column="1" Text="Perfis" Clicked="OnPerfisClicked"
                                BackgroundColor="#EAF3F1" TextColor="#2E7D6F" Padding="14,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Botão pesar -->
            <Button x:Name="PesarBtn" Text="Pesar" Clicked="OnPesarClicked"
                    BackgroundColor="#2E7D6F" TextColor="White" FontSize="18" HeightRequest="56" />

            <Label x:Name="StatusLabel" Text="Escolha o perfil, toque em Pesar e suba na balança."
                   FontSize="14" TextColor="#444444" />

            <!-- Resultado -->
            <Border x:Name="ResultadoCard" IsVisible="False"
                    Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Resultado" FontSize="13" TextColor="#777777" />

                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Label x:Name="PesoLabel" Text="--" FontSize="44" FontAttributes="Bold" TextColor="#2E7D6F" />
                        <Label Text="kg" FontSize="20" TextColor="#777777" VerticalOptions="End" Margin="0,0,0,10" />
                    </StackLayout>

                    <Label x:Name="QuandoLabel" Text="" FontSize="12" TextColor="#999999" />

                    <Grid x:Name="Grade" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Detalhes técnicos (para depuração) -->
            <Button Text="Detalhes técnicos" Clicked="OnToggleLog"
                    BackgroundColor="Transparent" TextColor="#999999" FontSize="12" />
            <Border x:Name="LogCard" IsVisible="False"
                    Stroke="#E0E0E0" StrokeThickness="1" BackgroundColor="White" Padding="10" HeightRequest="240">
                <ScrollView x:Name="LogScroll">
                    <Label x:Name="LogLabel" FontFamily="Monospace" FontSize="11" TextColor="#333333" />
                </ScrollView>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
