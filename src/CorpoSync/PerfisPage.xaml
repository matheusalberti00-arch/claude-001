<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorpoSync.PerfisPage"
             Title="Perfis"
             BackgroundColor="#121212">

    <Grid RowDefinitions="*,Auto" Padding="16" RowSpacing="12">

        <CollectionView x:Name="Lista" Grid.Row="0" SelectionMode="Single"
                        SelectionChanged="OnSelecionado">
            <CollectionView.EmptyView>
                <Label Text="Nenhum perfil ainda. Toque em 'Novo perfil'."
                       TextColor="#9E9E9E" HorizontalOptions="Center" Margin="0,40,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#2E2E2E" StrokeThickness="1" BackgroundColor="#1E1E1E"
                            Padding="14" Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Nome}" FontSize="17" FontAttributes="Bold" TextColor="#ECECEC" />
                            <Label Text="{Binding GarminEmail}" FontSize="12" TextColor="#9E9E9E" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Novo perfil" Clicked="OnNovoClicked"
                BackgroundColor="#2E9E86" TextColor="White" HeightRequest="52" />

    </Grid>

</ContentPage>
