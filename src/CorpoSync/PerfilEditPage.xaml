<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CorpoSync.PerfilEditPage"
             Title="Editar perfil"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="Nome" FontSize="13" TextColor="#9E9E9E" />
            <Entry x:Name="NomeEntry" Placeholder="Ex.: Matheus" PlaceholderColor="#6E6E6E"
                   TextColor="#ECECEC" BackgroundColor="#262626" />

            <Label Text="Dados do corpo (a balança usa para calcular)" FontSize="13" TextColor="#9E9E9E" Margin="0,6,0,0" />

            <Label Text="Sexo" FontSize="12" TextColor="#8A8A8A" />
            <Picker x:Name="SexoPicker" TextColor="#ECECEC" BackgroundColor="#262626">
                <Picker.Items>
                    <x:String>Masculino</x:String>
                    <x:String>Feminino</x:String>
                </Picker.Items>
            </Picker>

            <Label Text="Data de nascimento" FontSize="12" TextColor="#8A8A8A" />
            <DatePicker x:Name="NascPicker" Format="dd/MM/yyyy" TextColor="#ECECEC" BackgroundColor="#262626" />

            <Label Text="Altura (cm)" FontSize="12" TextColor="#8A8A8A" />
            <Entry x:Name="AlturaEntry" Keyboard="Numeric" Placeholder="Ex.: 170" PlaceholderColor="#6E6E6E"
                   TextColor="#ECECEC" BackgroundColor="#262626" />

            <Label Text="Login do Garmin (para enviar as pesagens)" FontSize="13" TextColor="#9E9E9E" Margin="0,6,0,0" />

            <Label Text="E-mail do Garmin" FontSize="12" TextColor="#8A8A8A" />
            <Entry x:Name="EmailEntry" Keyboard="Email" Placeholder="seu@email.com" PlaceholderColor="#6E6E6E"
                   TextColor="#ECECEC" BackgroundColor="#262626" />

            <Label Text="Senha do Garmin" FontSize="12" TextColor="#8A8A8A" />
            <Entry x:Name="SenhaEntry" IsPassword="True" Placeholder="••••••••" PlaceholderColor="#6E6E6E"
                   TextColor="#ECECEC" BackgroundColor="#262626" />
            <Label Text="A senha fica guardada protegida só no seu celular." FontSize="11" TextColor="#7A7A7A" />

            <Button Text="Salvar" Clicked="OnSalvarClicked"
                    BackgroundColor="#2E9E86" TextColor="White" HeightRequest="52" Margin="0,10,0,0" />

            <Button x:Name="ExcluirBtn" Text="Excluir perfil" Clicked="OnExcluirClicked"
                    BackgroundColor="Transparent" TextColor="#FF6B6B" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
